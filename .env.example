# Copy this file to ".env" and edit. Never commit the real .env.

# Where the database lives. Local SQLite file by default.
# Later, a managed Postgres would look like: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./mindaid.db

# "fake" = placeholder summaries, nothing is sent anywhere.
# "foundry" = (not built yet) would send entry text to Azure AI Foundry.
SUMMARISER_MODE=fake

# Used to sign the demo-login cookie. Change this to any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Port the web server listens on.
PORT=8000

# Set to true when running on HTTPS (e.g. Azure) so the login cookie is HTTPS-only.
COOKIE_SECURE=false

# Show the pre-made demo accounts and their password on the login page (true/false).
SHOW_DEMO_LOGINS=true
# Password for the pre-made demo accounts. It is displayed publicly, so don't reuse a real password.
DEMO_PASSWORD=demo-password-1

# Azure AI Foundry - only needed when SUMMARISER_MODE=foundry.
AZURE_AI_ENDPOINT=
AZURE_AI_DEPLOYMENT=
# A secret. Never commit it.
AZURE_AI_API_KEY=
# Where the model processes text, shown in the consent notice (only state what is true).
AZURE_AI_REGION=
